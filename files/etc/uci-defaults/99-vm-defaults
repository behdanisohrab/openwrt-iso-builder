#!/bin/sh
# VM Initial Configuration Defaults

uci batch <<'EOF'
# Configure LAN as DHCP client so the VM automatically gets an IP from the host/local router (e.g. 192.168.100.x)
set network.lan.proto='dhcp'
delete network.lan.ipaddr
delete network.lan.netmask
set dhcp.lan.ignore='1'

# Secondary interface as WAN DHCP client if present in VM
set network.wan=interface
set network.wan.device='eth1'
set network.wan.proto='dhcp'

set network.wan6=interface
set network.wan6.device='eth1'
set network.wan6.proto='dhcpv6'

commit network
commit dhcp
EOF

exit 0
